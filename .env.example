APP_NAME=IdentityGuard-X
APP_ENV=development
SECRET_KEY=replace-with-a-unique-local-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./identityguard.db
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
POSTGRES_DB=identityguard
POSTGRES_USER=identityguard
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RISK_WEIGHT_IDENTITY=0.20
RISK_WEIGHT_DEVICE=0.15
RISK_WEIGHT_NETWORK=0.10
RISK_WEIGHT_BEHAVIOR=0.15
RISK_WEIGHT_TEMPORAL=0.10
RISK_WEIGHT_GRAPH=0.10
RISK_WEIGHT_ML=0.15
RISK_WEIGHT_ANOMALY=0.05
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80
